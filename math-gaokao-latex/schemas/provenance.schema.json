{
  "$defs": {
    "answer_evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "pattern": "^.+$",
          "type": "string"
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "U"
          ]
        }
      },
      "required": [
        "grade",
        "evidence"
      ],
      "type": "object"
    },
    "question": {
      "additionalProperties": false,
      "properties": {
        "answer_evidence": {
          "$ref": "#/$defs/answer_evidence"
        },
        "answer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "conflict_status": {
          "enum": [
            "none",
            "resolved",
            "unresolved"
          ]
        },
        "issue_ids": {
          "items": {
            "pattern": "^ISSUE-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "printed_label": {
          "pattern": "^.+$",
          "type": "string"
        },
        "printed_number": {
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^.+$",
              "type": "string"
            }
          ]
        },
        "question_order": {
          "minimum": 1,
          "type": "integer"
        },
        "question_id": {
          "pattern": "^gk-[0-9]{4}-[a-z0-9-]+-q[0-9]{2,}$",
          "type": "string"
        },
        "question_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reviewer_role": {
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        "solver_role": {
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        "source_pages": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "transcription_review": {
          "$ref": "#/$defs/transcription_review"
        }
      },
      "required": [
        "question_id",
        "printed_number",
        "source_ref",
        "source_sha256",
        "source_pages",
        "question_text_sha256",
        "answer_sha256",
        "transcription_review",
        "answer_evidence",
        "solver_role",
        "reviewer_role",
        "conflict_status",
        "issue_ids"
      ],
      "type": "object"
    },
    "source_ref": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            }
          },
          "required": [
            "source_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "^.+\\.md$",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "transcription_review": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "pattern": "^.+$",
          "type": "string"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "uncertain"
          ]
        },
        "role": {
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "role",
        "result",
        "evidence"
      ],
      "type": "object"
    }
  },
  "$id": "provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^phase[0-9]+-b[0-9]{2}$",
      "type": "string"
    },
    "generated_by": {
      "const": "tools/provenance.py",
      "type": "string"
    },
    "paper_id": {
      "pattern": "^gk-[0-9]{4}-[a-z0-9-]+$",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "paper_id",
    "batch_id",
    "questions"
  ],
  "title": "Gaokao per-question provenance",
  "type": "object"
}
