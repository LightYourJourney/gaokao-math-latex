{
  "$defs": {
    "nullable_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      ]
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": [
            "object",
            "null"
          ]
        },
        "exam_type": {
          "enum": [
            "regular",
            "spring"
          ]
        },
        "git_blob_oid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "issue_ids": {
          "items": {
            "pattern": "^ISSUE-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "paper_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "paper_relation": {
          "enum": [
            null,
            "canonical",
            "exact_duplicate",
            "semantic_duplicate"
          ]
        },
        "raw_paper_name": {
          "type": "string"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "source_state": {
          "enum": [
            "not_started",
            "ready",
            "blocked",
            "non_paper"
          ]
        },
        "track": {
          "enum": [
            null,
            "arts",
            "science",
            "none"
          ]
        },
        "upstream_path": {
          "pattern": "^.+$",
          "type": "string"
        },
        "year": {
          "minimum": 1900,
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "upstream_path",
        "git_blob_oid",
        "year",
        "exam_type",
        "track",
        "regions",
        "raw_paper_name",
        "source_state",
        "paper_relation",
        "paper_id",
        "artifact",
        "issue_ids"
      ],
      "type": "object"
    }
  },
  "$id": "source-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "schemas/source-manifest.schema.json"
    },
    "batches": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "inventory": {
      "additionalProperties": false,
      "properties": {
        "root_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "total_sources": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_sources",
        "root_counts"
      ],
      "type": "object"
    },
    "last_transaction_id": {
      "$ref": "#/$defs/nullable_id"
    },
    "papers": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "type": "array"
    },
    "upstream": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "scoped_roots": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "commit",
        "scoped_roots"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "revision",
    "last_transaction_id",
    "upstream",
    "inventory",
    "sources",
    "papers",
    "batches"
  ],
  "title": "Gaokao source manifest skeleton",
  "type": "object"
}
