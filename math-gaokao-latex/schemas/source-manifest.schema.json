{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "git_oid_verified": {
          "const": true,
          "type": "boolean"
        },
        "header_is_pdf": {
          "const": true,
          "type": "boolean"
        },
        "media_type": {
          "const": "application/pdf",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "type": "integer"
        },
        "pdf_check": {
          "const": "passed",
          "type": "string"
        },
        "pdfinfo_version": {
          "pattern": "^.+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size_bytes",
        "sha256",
        "page_count",
        "media_type",
        "header_is_pdf",
        "git_oid_verified",
        "pdf_check",
        "pdfinfo_version"
      ],
      "type": "object"
    },
    "batch": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "pattern": "^phase[0-9]+-b[0-9]{2}$",
          "type": "string"
        },
        "issues": {
          "items": {
            "pattern": "^ISSUE-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "paper_ids": {
          "items": {
            "pattern": "^gk-[0-9]{4}-[a-z0-9-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "planned",
            "provenance_verified",
            "compiled_pending_review",
            "closed",
            "closed_with_blockers"
          ]
        }
      },
      "required": [
        "batch_id",
        "paper_ids",
        "status",
        "issues"
      ],
      "type": "object"
    },
    "figure_file": {
      "additionalProperties": false,
      "properties": {
        "expected_occurrences": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "pattern": "^[^/]+/figures/[^/]+\\.tex$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "expected_occurrences"
      ],
      "type": "object"
    },
    "legacy_source_file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^.+\\.md$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "nullable_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      ]
    },
    "paper": {
      "additionalProperties": false,
      "properties": {
        "blocked_from": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "legacy_unverified",
                "planned",
                "source_ready",
                "transcription_draft",
                "questions_verified",
                "answers_draft",
                "answers_verified",
                "shared_frozen",
                "editions_generated",
                "compiled",
                "complete",
                "blocked"
              ]
            }
          ]
        },
        "figure_files": {
          "items": {
            "$ref": "#/$defs/figure_file"
          },
          "type": "array",
          "uniqueItems": true
        },
        "issue_ids": {
          "items": {
            "pattern": "^ISSUE-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "last_verified_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "legacy_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "legacy_source_files": {
          "items": {
            "$ref": "#/$defs/legacy_source_file"
          },
          "type": "array",
          "uniqueItems": true
        },
        "paper_id": {
          "pattern": "^gk-[0-9]{4}-[a-z0-9-]+$",
          "type": "string"
        },
        "production_state": {
          "enum": [
            "legacy_unverified",
            "planned",
            "source_ready",
            "transcription_draft",
            "questions_verified",
            "answers_draft",
            "answers_verified",
            "shared_frozen",
            "editions_generated",
            "compiled",
            "complete",
            "blocked"
          ]
        },
        "project_dir": {
          "pattern": "^[^/]+$",
          "type": "string"
        },
        "question_count": {
          "minimum": 1,
          "type": "integer"
        },
        "resume_action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^.+$",
              "type": "string"
            }
          ]
        },
        "source_files": {
          "$ref": "#/$defs/source_files"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "pattern": "^.+$",
          "type": "string"
        },
        "track": {
          "enum": [
            "arts",
            "science",
            "none"
          ]
        },
        "year": {
          "minimum": 1900,
          "type": "integer"
        }
      },
      "required": [
        "paper_id",
        "legacy_ids",
        "project_dir",
        "title",
        "year",
        "track",
        "question_count",
        "source_files",
        "figure_files",
        "legacy_source_files",
        "source_ids",
        "production_state",
        "issue_ids",
        "blocked_from",
        "last_verified_hash",
        "resume_action"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "exam_type": {
          "enum": [
            "regular",
            "spring"
          ]
        },
        "git_blob_oid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "issue_ids": {
          "items": {
            "pattern": "^ISSUE-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "paper_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "paper_relation": {
          "enum": [
            null,
            "canonical",
            "exact_duplicate",
            "semantic_duplicate"
          ]
        },
        "raw_paper_name": {
          "type": "string"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "source_state": {
          "enum": [
            "not_started",
            "ready",
            "blocked",
            "non_paper"
          ]
        },
        "track": {
          "enum": [
            null,
            "arts",
            "science",
            "none"
          ]
        },
        "upstream_path": {
          "pattern": "^.+$",
          "type": "string"
        },
        "year": {
          "minimum": 1900,
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "upstream_path",
        "git_blob_oid",
        "year",
        "exam_type",
        "track",
        "regions",
        "raw_paper_name",
        "source_state",
        "paper_relation",
        "paper_id",
        "artifact",
        "issue_ids"
      ],
      "type": "object"
    },
    "source_files": {
      "additionalProperties": false,
      "properties": {
        "answer_key": {
          "pattern": "^[^/]+/[^/]+\\.md$",
          "type": "string"
        },
        "combined_rendered": {
          "pattern": "^[^/]+/[^/]+\\.md$",
          "type": "string"
        },
        "questions": {
          "pattern": "^[^/]+/[^/]+\\.md$",
          "type": "string"
        },
        "solution_body": {
          "pattern": "^[^/]+/[^/]+\\.md$",
          "type": "string"
        }
      },
      "required": [
        "questions",
        "answer_key",
        "solution_body",
        "combined_rendered"
      ],
      "type": "object"
    }
  },
  "$id": "source-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "schemas/source-manifest.schema.json"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/batch"
      },
      "type": "array"
    },
    "inventory": {
      "additionalProperties": false,
      "properties": {
        "root_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "total_sources": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_sources",
        "root_counts"
      ],
      "type": "object"
    },
    "last_transaction_id": {
      "$ref": "#/$defs/nullable_id"
    },
    "papers": {
      "items": {
        "$ref": "#/$defs/paper"
      },
      "type": "array"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "type": "array"
    },
    "upstream": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "scoped_roots": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "commit",
        "scoped_roots"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "revision",
    "last_transaction_id",
    "upstream",
    "inventory",
    "sources",
    "papers",
    "batches"
  ],
  "title": "Gaokao source manifest",
  "type": "object"
}
